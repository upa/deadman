# Cache IP version lookups to avoid repeated DNS queries
_ipversion_cache = {}

def whichipversion(addr):
    if addr in _ipversion_cache:
        return _ipversion_cache[addr]

    try:
        # Quick check if it's a raw IP address first (fastest)
        try:
            socket.inet_pton(socket.AF_INET, addr)
            _ipversion_cache[addr] = 4
            return 4
        except:
            pass

        try:
            socket.inet_pton(socket.AF_INET6, addr)
            _ipversion_cache[addr] = 6
            return 6
        except:
            pass

        # If not a raw IP, do DNS lookup
        (family, _, _, _, saddr) = socket.getaddrinfo(addr, None)[0]
        if family == socket.AF_INET:
            _ipversion_cache[addr] = 4
            return 4
        elif family == socket.AF_INET6:
            _ipversion_cache[addr] = 6
            return 6
    except:
        _ipversion_cache[addr] = False
        return False

    _ipversion_cache[addr] = False
    return False


def pingcmd(osname, ipv):

    """
    XXX: add new osname (uname -s) to support new OS.

    Timeout is controlled by asyncio.wait_for.
    As a result, there is no difference :0 I need cleanup.
    """
    if (osname == "Linux" or
        osname == "Darwin" or
        osname == "FreeBSD"):
        if ipv == 4: return ["ping", "-c", "1"]
        if ipv == 6:
            if which('ping6'): return ["ping6", "-c", "1"]
            else: return ["ping", "-c", "1"]

    return None



