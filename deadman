# Lazy-load hostname to avoid blocking DNS lookup at startup
_hostname_cache = None
_hostinfo_cache = None

def get_hostname():
    global _hostname_cache
    if _hostname_cache is None:
        _hostname_cache = socket.gethostname()
    return _hostname_cache

def get_hostinfo_lazy():
    global _hostinfo_cache
    if _hostinfo_cache is None:
        hostname = get_hostname()
        try:
            # Quick timeout to avoid blocking
            socket.setdefaulttimeout(0.5)
            ip = socket.gethostbyname(hostname)
            _hostinfo_cache = "From: %s (%s)" % (hostname, ip)
            socket.setdefaulttimeout(None)
        except:
            _hostinfo_cache = "From: %s" % hostname
    return _hostinfo_cache

GLOBAL_STEP = 0
QUIT_FLAG = False

def increment_global_step():
    global GLOBAL_STEP
    GLOBAL_STEP += 1

def set_quit_flag():
    global QUIT_FLAG
    QUIT_FLAG = True

def get_quit_flag():
    global QUIT_FLAG
    return QUIT_FLAG

def get_title_hostinfo(with_wheel = False):
    hostinfo = get_hostinfo_lazy()
    if not with_wheel:
        return hostinfo
    else:
        global GLOBAL_STEP
        return hostinfo + " " + ["|", "/", "-", "\\"][GLOBAL_STEP % 4]



